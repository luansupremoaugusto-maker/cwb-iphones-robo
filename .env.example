APP_ENV=development
PORT=8000
DATABASE_URL=sqlite:///./data/robo.db

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

MERCADO_PHONE_BASE_URL=https://platform.mercadophone.tech
MERCADO_PHONE_FILES_URL=https://app.mercadophone.tech/api.php?class=ArquivoApiController&method=index
MERCADO_PHONE_API_KEY=
MERCADO_SYSTEM_UNIT_ID=2620
MERCADO_PAGE_LIMIT=300
MERCADO_CACHE_TTL_SECONDS=60
MERCADO_REFRESH_INTERVAL_SECONDS=300

# O robo le somente os precos da aba BOT.
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEETS_SPREADSHEET_ID=1s-t25cIy4ZVvM92icsXyn5hooDFzboFMeaFiwJdninc
GOOGLE_SHEETS_PRICES_TAB=BOT
GOOGLE_SHEETS_PRICES_RANGE=A1:E500
GOOGLE_SHEETS_CACHE_TTL_SECONDS=3600
GOOGLE_SHEETS_REFRESH_INTERVAL_SECONDS=3600

# Opcao mais simples: URL CSV publica somente da aba BOT.
# GOOGLE_SHEETS_PUBLIC_CSV_URL=https://docs.google.com/spreadsheets/d/ID/export?format=csv&gid=901822279

# Opcao privada, se a politica do Google Cloud permitir conta de servico.
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={}

# Taxas fixas de parcelamento: app/installments.py

ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
# Opcional; usado como cabeÃ§alho adicional quando a conta exigir.
ZAPI_CLIENT_TOKEN=
ZAPI_WEBHOOK_SECRET=change-this-webhook-secret
ZAPI_EXPECTED_INSTANCE_ID=

ADMIN_PHONES=
TEST_PHONES=
OUTBOUND_MODE=disabled
FAQ_PATH=data/faq.yaml
RETENTION_DAYS=30
MEDIA_MAX_BYTES=15000000
MESSAGE_BATCH_WAIT_SECONDS=10

# Docker Compose / Caddy
DOMAIN=bot.example.com
POSTGRES_PASSWORD=change-this-password
